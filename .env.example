# Required in production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname   # local default: SQLite file my_sales.db
SITE_URL=https://your-domain.example                  # used in password-reset links
APP_TIMEZONE=Asia/Kolkata
CRON_SECRET=change-me                                 # protects /api/cron/expire-trials

# Trial
TRIAL_DAYS=20
TRIAL_CONTACT=9014040855

# Outgoing email (login OTP + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Mobile OTP through Brevo SMS
BREVO_API_KEY=
BREVO_SMS_SENDER=

# UPI: Testing shows a non-chargeable QR; Live calls your gateway
UPI_ENABLED=1
UPI_MODE=Testing
UPI_ID=
UPI_PAYMENT_API_URL=
UPI_API_KEY=
UPI_API_SECRET=
UPI_REDIRECT_TO=

# MSA assistant (local Ollama, no API key)
MSA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
